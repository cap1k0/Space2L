# Supabase Postgres — Settings → Database → Connection string
# Use the Session Pooler URL (port 6543), not the direct connection —
# required for serverless environments like Vercel.
DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

NEXT_PUBLIC_SERVER_URL=https://cms.bruca.space

# Vercel Blob — Vercel dashboard → Storage → Create Blob store
BLOB_READ_WRITE_TOKEN=
